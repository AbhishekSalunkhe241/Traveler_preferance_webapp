NODE_ENV=production
PORT=5000
API_VERSION=v1
FRONTEND_URL=https://your-frontend.vercel.app

DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-postgres-user
DB_PASSWORD=your-postgres-password
DB_NAME=codenova_db
DB_SSL=true
DB_POOL_MIN=0
DB_POOL_MAX=10

REDIS_URL=redis://your-redis-host:6379
REDIS_KEY_PREFIX=codenova:
REDIS_SESSION_TTL=604800
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=replace-with-a-32-character-key

ANTHROPIC_AUTH_TOKEN=replace-with-your-openrouter-key
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_MODEL=google/gemini-2.0-flash-001
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
ML_SERVICE_URL=https://your-ml-service.example.com
ML_SERVICE_TIMEOUT_MS=30000

MAPS_API_KEY=
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP=

GST_PERCENTAGE=18
PLATFORM_FEE_PERCENTAGE=5
MIN_OPERATOR_MARGIN_PERCENTAGE=10
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_PAYMENT_MAX=5
LOG_LEVEL=info
LOG_FORMAT=pretty
